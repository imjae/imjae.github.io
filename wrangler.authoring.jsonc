{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imjae-blog-author",
  "main": "server/author-auth.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "GITHUB_CLIENT_ID": "Ov23liP7iIh0hmeTFXlz",
    "ALLOWED_GITHUB_ID": "37284282"
  },
  "assets": {
    "directory": "./.authoring-dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTHOR_SESSIONS",
        "class_name": "AuthorSessions"
      },
      {
        "name": "SKETCH_REVIEWS",
        "class_name": "SketchReviews"
      },
      {
        "name": "SKETCH_QUESTIONS",
        "class_name": "SketchQuestions"
      },
      {
        "name": "OWNER_POSTS",
        "class_name": "OwnerPosts"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AuthorSessions"
      ]
    },
    {
      "tag": "v2-sketch-reviews",
      "new_sqlite_classes": ["SketchReviews"]
    },
    {
      "tag": "v3-sketch-questions",
      "new_sqlite_classes": ["SketchQuestions"]
    },
    {
      "tag": "v4-owner-posts",
      "new_sqlite_classes": ["OwnerPosts"]
    }
  ]
}

---
interface Props { editing?: boolean; viewerUrl: string; editorUrl: string; editorExternal?: boolean; editorTitle?: string; label?: string; }
const { editing = false, viewerUrl, editorUrl, editorExternal = false, editorTitle = 'Edit this article on GitHub (new tab)', label = 'Blog mode' } = Astro.props;
---
<nav class="mode-switch" aria-label={label}>
  <a href={viewerUrl} data-view-mode aria-current={!editing ? 'page' : undefined}>View</a>
  <a href={editorUrl} aria-current={editing ? 'page' : undefined} target={editorExternal ? '_blank' : undefined} rel={editorExternal ? 'noopener noreferrer' : undefined} title={editorExternal ? editorTitle : undefined}>Edit{editorExternal && <span aria-hidden="true"> ↗</span>}</a>
</nav>
<style>
  .mode-switch{display:flex;align-items:center;border:1px solid var(--line);border-radius:5px;padding:3px;gap:2px;flex-shrink:0;font-size:10px}
  .mode-switch a{padding:7px 10px;border-radius:3px;white-space:nowrap;color:var(--muted)}
  .mode-switch a[aria-current]{color:var(--green);background:#e5ece1;font-weight:650}
  .mode-switch a:hover{color:var(--green)}
  @media(max-width:760px){.mode-switch{margin-left:auto;font-size:10px}.mode-switch a{padding:7px 9px}}
  @media print{.mode-switch{display:none}}
</style>

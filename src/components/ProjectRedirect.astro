---
import { site } from '../data/site';
interface Props { target: string; }
const { target } = Astro.props;
---
<!doctype html>
<html lang="ko"><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={new URL(target, site.url)} />
  <title>Projects 페이지로 이동</title>
  <script is:inline define:vars={{ target }}>window.location.replace(target + window.location.search + window.location.hash);</script>
  <noscript><meta http-equiv="refresh" content={`0;url=${target}`} /></noscript>
</head><body><p><a href={target}>Projects 페이지로 이동</a></p></body></html>

---
import type { PortfolioMedia } from '../../data/krafton-2027';
import { resolvePortfolioMedia } from '../../lib/recruitment-media.mjs';
interface Props {
  media?: PortfolioMedia;
  loading?: 'eager' | 'lazy';
  slotId?: string;
  placeholderTitle?: string;
  label?: string;
}
const resolved = resolvePortfolioMedia(Astro.props.media);
const { loading = 'lazy', slotId, placeholderTitle, label = 'DETAIL VIDEO' } = Astro.props;
const hasPlayer = Boolean(resolved?.embedUrl || resolved?.videoSrc);
---
{(resolved || placeholderTitle) && <figure class:list={['rp-media', { 'rp-media-empty': !resolved }]} data-video-slot={slotId}>
  {resolved?.embedUrl && <div class="rp-video-frame"><iframe
    src={resolved.embedUrl} title={resolved.title} loading={loading}
    allow="encrypted-media; picture-in-picture; fullscreen" allowfullscreen
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe></div>}
  {resolved?.videoSrc && <div class="rp-video-frame"><video
    src={resolved.videoSrc} aria-label={resolved.title} controls playsinline preload="metadata"
  ></video></div>}
  {!hasPlayer && placeholderTitle && <div class="rp-video-frame rp-video-placeholder">
    <span class="rp-media-label">{label}</span>
    <div><strong>{resolved ? '외부 영상' : '영상 준비 중'}</strong><p>{resolved ? '아래 원본 링크에서 볼 수 있습니다.' : '영상이 등록되면 이곳에서 재생합니다.'}</p></div>
  </div>}
  <figcaption>
    <strong>{resolved?.title || placeholderTitle}</strong>
    {resolved && <><span>{resolved.caption}</span><a href={resolved.url} target="_blank" rel="noopener noreferrer">영상 원본 보기 ↗<span class="rp-sr-only"> (새 탭)</span></a></>}
  </figcaption>
</figure>}

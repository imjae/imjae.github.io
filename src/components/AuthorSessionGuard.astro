<span hidden data-author-session></span>
<script>
  if (document.querySelector('[data-author-session]')) {
  let checking = false;
  async function checkAuthorSession() {
    if (checking || document.visibilityState === 'hidden') return;
    checking = true;
    try {
      const response = await fetch('/auth/session', { credentials: 'same-origin', cache: 'no-store', redirect: 'error', headers: { Accept: 'application/json' } });
      if (response.status === 401) {
        location.replace('/auth/login?return_to=' + encodeURIComponent(location.pathname + location.search + location.hash));
      } else if (!response.ok) throw new Error('Session unavailable');
    } catch {
      document.querySelectorAll<HTMLElement>('[contenteditable]').forEach(node => { node.contentEditable = 'false'; });
      document.querySelectorAll<HTMLButtonElement>('[data-portfolio-edit]').forEach(node => { node.disabled = true; });
      if (!document.querySelector('#author-session-error')) {
        const notice = document.createElement('p'); notice.id = 'author-session-error'; notice.setAttribute('role', 'alert');
        notice.textContent = '로그인 상태를 확인할 수 없습니다. 다시 접속해 주세요.';
        document.querySelector('main')?.prepend(notice);
      }
    } finally { checking = false; }
  }
  addEventListener('pageshow', checkAuthorSession);
  addEventListener('focus', checkAuthorSession);
  document.addEventListener('visibilitychange', checkAuthorSession);
  setInterval(checkAuthorSession, 60000);
  }
</script>

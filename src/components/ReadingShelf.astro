---
import { articleUrl, formatDate } from '../lib/articles';
import { getReadingItems } from '../lib/reading-shelf.server';
import { privateAuthoring } from '../lib/authoring.server.mjs';
const books = await getReadingItems();
const noteCount = books.filter(item => item.article).length;
---
<section class="reading-shelf" aria-labelledby="bookshelf-title">
  <div class="section-heading shelf-heading">
    <h2 id="bookshelf-title">Bookshelf <span>{books.length}</span></h2>
    {privateAuthoring && <a class="text-link" href="/editor/?topic=reading#new-post">독서 기록 추가 <span aria-hidden="true">↗</span></a>}
  </div>
  <label class="search-box"><span aria-hidden="true">⌕</span><input id="book-search" type="search" placeholder="책 제목, 저자, 감상에서 검색" aria-label="독서 기록 검색" autocomplete="off" /><kbd>/</kbd></label>
  <div class="filter-row"><label for="book-view" class="sr-only">기록 종류</label><select id="book-view"><option value="all">전체 기록</option><option value="notes">독서 메모</option><option value="listed">감상 미작성</option></select></div>
  <p id="book-count" class="shelf-count" role="status" aria-live="polite">{books.length}권 · 독서 메모 {noteCount}편</p>
  <div class="book-list">
    {books.map((item, index) => {
      const { book, article } = item;
      const searchText = [book.title, book.author, book.note, ...item.sources.map((source: { title: string }) => source.title), article?.data.title, article?.data.description, article?.body].filter(Boolean).join(' ').toLocaleLowerCase();
      return <article class="book-entry" data-book={item.slug} data-book-search={searchText} data-has-note={!!article}>
        <span class="book-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div class="book-content">
          <div class="book-meta"><span>{book.author ?? '저자 미기재'}</span>{article?.data.draft && <span class="draft-label">초안</span>}<span>{book.finished ? '완독 ' : '기록 '}<time datetime={book.finished ?? item.date}>{formatDate(book.finished ?? item.date)}</time></span></div>
          <h3>{article ? <a href={articleUrl(article)}>{book.title}</a> : book.title}</h3>
          <div class="book-note"><p class="book-note-label">{article ? book.note ? '짧은 감상' : '기록 요약' : '감상 미작성'}</p>{article ? <p>{book.note ?? article.data.description}</p> : <p>책 목록에 남긴 기록입니다.{item.rating && <> 기록한 별점은 {item.rating}/5입니다.</>}</p>}</div>
          {article ? <a class="book-more" href={articleUrl(article)}>독서 메모 읽기 <span aria-hidden="true">→</span></a> : privateAuthoring && <a class="book-more" href={`/editor/?topic=reading&book=${encodeURIComponent(item.slug)}#new-post`}>감상 남기기 <span aria-hidden="true">↗</span></a>}
        </div>
      </article>;
    })}
  </div>
  <p id="no-books" class="empty-state" hidden={books.length > 0}>{books.length > 0 ? '검색 결과가 없습니다. 검색어나 기록 종류를 바꿔 보세요.' : '아직 등록된 독서 기록이 없습니다.'}</p>
</section>
<script>
  const search = document.querySelector<HTMLInputElement>('#book-search');
  const view = document.querySelector<HTMLSelectElement>('#book-view');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-book]')];
  const params = new URLSearchParams(location.search);
  if (search) search.value = params.get('q') ?? '';
  if (view) view.value = ['notes', 'listed'].includes(params.get('view') ?? '') ? params.get('view')! : 'all';
  function filterBooks() {
    if (!search) return;
    const words = search.value.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);
    let visible = 0;
    let notes = 0;
    for (const card of cards) {
      const matchesView = view?.value === 'notes' ? card.dataset.hasNote === 'true' : view?.value === 'listed' ? card.dataset.hasNote !== 'true' : true;
      card.hidden = !matchesView || !words.every(word => card.dataset.bookSearch?.includes(word));
      if (!card.hidden) { visible++; if (card.dataset.hasNote === 'true') notes++; }
    }
    const count = document.querySelector('#book-count');
    const empty = document.querySelector<HTMLElement>('#no-books');
    if (count) count.textContent = `${visible}권 · 독서 메모 ${notes}편`;
    if (empty) empty.hidden = visible > 0;
    const next = new URLSearchParams(location.search);
    if (search.value.trim()) next.set('q', search.value.trim()); else next.delete('q');
    if (view?.value && view.value !== 'all') next.set('view', view.value); else next.delete('view');
    history.replaceState(null, '', location.pathname + (next.size ? `?${next}` : '') + location.hash);
  }
  search?.addEventListener('input', filterBooks);
  view?.addEventListener('change', filterBooks);
  document.addEventListener('keydown', event => {
    if (event.key === '/' && !(event.target instanceof HTMLInputElement) && !(event.target instanceof HTMLTextAreaElement) && !(event.target instanceof HTMLElement && event.target.isContentEditable)) { event.preventDefault(); search?.focus(); }
  });
  filterBooks();
</script>
<style>
  .shelf-heading{align-items:center;gap:20px;flex-wrap:wrap}.shelf-count{font-size:11px;color:var(--muted);margin:22px 0 14px}
  .book-list{border-top:1px solid var(--line)}.book-entry{display:grid;grid-template-columns:42px minmax(0,1fr);gap:22px;padding:30px 0;border-bottom:1px solid var(--line)}
  .book-number{font:13px var(--mono);color:#997c6f;padding-top:5px}.book-content{min-width:0}.book-meta{display:flex;gap:14px;flex-wrap:wrap;font-size:11px;color:var(--muted);line-height:1.8}.book-meta>span:last-child{margin-left:auto}.book-meta time{font:10px var(--mono)}
  .book-content h3{font-size:24px;line-height:1.6;letter-spacing:-.6px;margin:12px 0 18px;overflow-wrap:anywhere}.book-content h3 a:hover{color:var(--green)}
  .book-note{border-left:2px solid #c7b3a4;padding-left:18px;max-width:720px}.book-note-label{font-size:10px;color:#8a685e;margin:0 0 7px}.book-note>p:last-child{font-size:13px;line-height:2;white-space:pre-line;overflow-wrap:anywhere;margin:0}
  .book-more{display:inline-block;font-size:11px;color:var(--green);margin-top:20px}.book-more:hover{text-decoration:underline;text-underline-offset:4px}
  @media(max-width:760px){.book-entry{grid-template-columns:24px minmax(0,1fr);gap:12px;padding:25px 0}.book-content h3{font-size:21px}.book-meta>span:last-child{margin-left:0}.book-note{padding-left:13px}.book-note>p:last-child{font-size:12px}.shelf-heading .text-link{font-size:11px}}
</style>

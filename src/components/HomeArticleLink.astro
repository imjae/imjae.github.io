---
import type { Article } from '../lib/articles';
import { articleUrl } from '../lib/articles';
import { getTopic } from '../data/site';
interface Props { article: Article; index: number; }
const { article, index } = Astro.props;
const topic = getTopic(article.data.topic);
---
<article class="home-article" data-entry={article.data.slug}>
  <a href={articleUrl(article)}>
    <span class="home-article-number" aria-hidden="true">{String(index).padStart(2, '0')}</span>
    <span class="home-article-topic">{topic.title}</span>
    <h3>{article.data.title}</h3>
    <span class="home-article-arrow" aria-hidden="true">↗</span>
  </a>
</article>
<style>
  .home-article { border-bottom: 1px solid var(--line); }
  .home-article a { display: grid; grid-template-columns: 40px 145px minmax(0, 1fr) 22px; align-items: center; gap: 20px; padding: 25px 0; min-height: 84px; }
  .home-article-number { color: var(--muted); font: 10px var(--mono); }
  .home-article-topic { color: #647970; font: 11px var(--mono); }
  h3 { font-size: 17px; font-weight: 500; letter-spacing: -.45px; line-height: 1.6; margin: 0; }
  .home-article-arrow { color: #738683; font-size: 21px; text-align: right; }
  a:hover h3 { color: var(--green); text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 900px) { .home-article a { grid-template-columns: 24px 115px minmax(0, 1fr) 18px; gap: 12px; } }
  @media (max-width: 600px) {
    .home-article a { grid-template-columns: 20px minmax(0, 1fr) 20px; gap: 7px 12px; padding: 21px 0; }
    .home-article-number { grid-column: 1; grid-row: 1; font-size: 9px; }
    .home-article-topic { grid-column: 2; grid-row: 1; font-size: 9px; }
    h3 { grid-column: 2; font-size: 15px; line-height: 1.75; }
    .home-article-arrow { grid-column: 3; grid-row: 1 / 3; }
  }
  @media (max-width: 360px) { h3 { font-size: 14px; } }
</style>

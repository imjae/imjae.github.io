---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects.mjs';
---
<BaseLayout title="Projects" description="프로젝트 소개와 개발 기록, 기획서와 리소스." active="projects">
  <header class="projects-heading"><h1>Projects</h1><p>프로젝트 소개와 개발 기록, 기획서와 리소스.</p></header>
  <div class="project-albums">
    {projects.map(project => <a class="project-album" href={`/projects/${project.id}/`}>
      <img src={project.cover} alt={project.alt} width="960" height="720" decoding="async" />
      <h2>{project.title}</h2>
    </a>)}
  </div>
</BaseLayout>
<style>
  .projects-heading { margin-bottom: 42px; }
  h1 { margin: 0; font-size: 32px; font-weight: 650; letter-spacing: -.035em; }
  .projects-heading p { margin: 10px 0 0; color: var(--muted); font-size: 14px; }
  .project-albums { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 30px; padding-bottom: 100px; }
  .project-album { display: block; min-width: 0; color: inherit; text-decoration: none; }
  .project-album img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 3px; background: #e8e9e2; }
  .project-album h2 { margin: 17px 0 0; font-size: 18px; font-weight: 600; letter-spacing: -.025em; }
  .project-album:hover h2 { text-decoration: underline; text-underline-offset: 5px; }
  .project-album:focus-visible { outline: 2px solid var(--green); outline-offset: 7px; border-radius: 3px; }
  @media (max-width: 760px) { .project-albums { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 22px; } }
  @media (max-width: 520px) { .projects-heading { margin-bottom: 28px; } h1 { font-size: 29px; } .project-albums { grid-template-columns: 1fr; gap: 34px; padding-bottom: 50px; } }
</style>

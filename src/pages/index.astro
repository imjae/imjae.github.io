---
import BaseLayout from '../layouts/BaseLayout.astro';
import SystemSketch from '../components/SystemSketch.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles } from '../lib/articles';
import { topics, cases } from '../data/site';
const articles = (await getArticles()).filter((article) => !article.data.legacy);
---
<BaseLayout active="home">
  <section class="home-hero">
    <div class="hero-copy"><p class="eyebrow"><span class="live-dot"></span> GAMEPLAY / GRAPHICS / ENGINEERING</p><h1>게임이 움직이는<br/><em>이유를 기록합니다.</em></h1><p class="hero-description">화면에 보이는 결과부터, 그 아래의 로직까지.<br/>직접 만들며 부딪힌 문제와 선택의 과정을 남깁니다.</p><a class="text-link" href="/about/">이 기록에 대하여 <span aria-hidden="true">↗</span></a></div>
    <SystemSketch />
  </section>
  <section class="project-feature" aria-labelledby="project-title">
    <div class="project-feature-heading"><div><p class="eyebrow">FEATURED PROJECT / UNITY · C# · HDRP</p><h2 id="project-title">DCB <span>지게를 지고, 위험한 길을 통과하는 게임.</span></h2></div><a class="button button-dark" href="/portfolio/dcb/">프로젝트 살펴보기 <span aria-hidden="true">↗</span></a></div>
    <div class="project-case-links">{cases.map((item) => <a href={`/writing/${item.slug}/`}><span>{item.number}</span>{item.label}<span aria-hidden="true">↗</span></a>)}</div>
  </section>
  <section class="latest-section" aria-labelledby="latest-title">
    <div class="section-heading"><div><p class="eyebrow">THE DEVELOPMENT LOG</p><h2 id="latest-title">최근 기록 <span>{articles.length.toString().padStart(2, '0')}</span></h2></div><a class="text-link" href="/writing/">전체 글 보기 <span aria-hidden="true">→</span></a></div>
    <div class="article-list">{articles.slice(0, 6).map((article) => <ArticleCard article={article} />)}</div>
  </section>
  <section class="topic-section" aria-labelledby="topics-title"><div class="section-heading"><div><p class="eyebrow">FIND A THREAD</p><h2 id="topics-title">주제로 이어 읽기</h2></div></div><div class="topic-grid">{topics.slice(0,4).map((topic) => <a class="topic-tile" href={`/topics/${topic.id}/`} style={`--topic-color:${topic.color}`}><span>{topic.number} / {topic.english}</span><h3>{topic.title} <span aria-hidden="true">↗</span></h3><p>{topic.description}</p></a>)}</div></section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import SystemSketch from '../components/SystemSketch.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles } from '../lib/articles';
import { selectPinnedArticles } from '../lib/pinned-articles.mjs';
import { topics } from '../data/site';
const pinnedArticles = selectPinnedArticles(await getArticles(false));
---
<BaseLayout title="Home" active="home">
  <section class="home-hero">
    <div class="hero-copy"><p class="eyebrow">GAME DEVELOPMENT</p><h1>imjae의 개발 블로그</h1><p class="hero-description">Unity와 C#으로 게임을 개발합니다.</p></div>
    <SystemSketch />
  </section>
  {pinnedArticles.length > 0 && <section class="latest-section" aria-labelledby="pinned-title">
    <div class="section-heading"><div><h2 id="pinned-title">Pinned <span>{pinnedArticles.length.toString().padStart(2, '0')}</span></h2></div><a class="text-link" href="/writing/">전체 글 보기 <span aria-hidden="true">→</span></a></div>
    <div class="article-list">{pinnedArticles.map((article) => <ArticleCard article={article} />)}</div>
  </section>}
  <section class="topic-section" aria-labelledby="topics-title"><div class="section-heading"><div><h2 id="topics-title">주제별 글</h2></div></div><div class="topic-grid">{topics.map((topic) => <a class="topic-tile" href={`/topics/${topic.id}/`} style={`--topic-color:${topic.color}`}><span>{topic.number} / {topic.english}</span><h3>{topic.title} <span aria-hidden="true">↗</span></h3><p>{topic.description}</p></a>)}</div></section>
  <section class="project-feature" aria-labelledby="project-title" style="margin-top:40px;margin-bottom:0">
    <div class="project-feature-heading"><div><p class="eyebrow">개발 중인 프로젝트</p><h2 id="project-title">DCB <span>지게로 짐을 운반하는 액션 게임</span></h2></div><a class="button button-dark" href="/portfolio/dcb/">프로젝트 보기 <span aria-hidden="true">↗</span></a></div>
  </section>
</BaseLayout>

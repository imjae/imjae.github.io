---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeTopicCover from '../components/HomeTopicCover.astro';
import { topics, getTopic } from '../data/site';
import { getHomeCovers } from '../data/home-covers';
import { getArticles, articleUrl, formatDate } from '../lib/articles';
import { selectPinnedArticles } from '../lib/pinned-articles.mjs';

const articles = await getArticles(false);
const covers = getHomeCovers(articles);
const pinned = selectPinnedArticles(articles).map(article => article.data.slug);
const index = articles.map(article => ({
  slug: article.data.slug, topic: article.data.topic,
  text: [article.data.title, article.data.description, getTopic(article.data.topic).title, article.data.book?.title ?? '', article.data.book?.author ?? '', article.data.book?.note ?? '', ...article.data.tags].join(' ').toLocaleLowerCase(),
}));
---
<BaseLayout title="Home" active="home" description="개발, 기술, 수학과 책에 관한 기록입니다.">
  <div class="home-covers home-wrap">
    <h1 class="sr-only">글 목록</h1>
    <div class="home-filter-bar">
      <nav class="home-topics" aria-label="Topics">
        <a href="/" data-home-topic="" aria-current="true">All</a>
        {topics.map(topic => <a href={`/topics/${topic.id}/`} data-home-topic={topic.id}>{topic.title}</a>)}
      </nav>
      <label class="home-search" hidden><span class="sr-only">제목, 요약과 태그에서 글 검색</span><input id="home-search" type="search" aria-label="글 검색" placeholder="글 검색" autocomplete="off" /></label>
    </div>
    <section class="home-cover-grid" aria-label="주제별 대표 글">
      {covers.map(cover => <HomeTopicCover cover={cover} />)}
    </section>
    <section id="home-results" class="home-results" aria-labelledby="home-list-title" tabindex="-1">
      <div class="home-list-heading">
        <h2 id="home-list-title">최근 글</h2>
        <div class="home-list-actions">
          {pinned.length > 0 && <button type="button" id="home-pins" aria-pressed="false" hidden>고정 글 <span>{pinned.length}</span></button>}
          <a id="home-more" href="/writing/">전체 글 보기 <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="home-result-meta" hidden><p id="home-result-count" role="status" aria-live="polite"></p><button type="button" id="home-reset">필터 초기화</button></div>
      <div id="home-article-list">
        {articles.map((article, position) => <article class="home-row" data-home-entry={article.data.slug} data-home-pin={pinned.indexOf(article.data.slug) >= 0 ? pinned.indexOf(article.data.slug) : undefined} hidden={position >= 5}>
          <span class="home-row-topic">{getTopic(article.data.topic).title}</span>
          <h3><a href={articleUrl(article)}>{article.data.title}</a></h3>
          <time datetime={article.data.date}>{formatDate(article.data.date)}</time>
        </article>)}
      </div>
      <p id="home-empty" hidden>찾는 글이 없습니다. 검색어를 바꾸거나 필터를 초기화해 보세요.</p>
    </section>
    <script type="application/json" id="home-index" set:html={JSON.stringify({ articles: index, pinned, topics: topics.map(({ id, title }) => ({ id, title })) }).replaceAll('<', '\\u003c')} />
  </div>
</BaseLayout>
<script>
  import '../scripts/home-covers';
</script>
<style>
  :global(body.home-page) { background: #fff; }
  .home-wrap { width: calc(100% - 112px); max-width: 1200px; margin-inline: auto; }
  .home-filter-bar { display: flex; align-items: center; gap: 25px; padding: 18px 0 24px; margin-bottom: 5px; }
  .home-topics { display: flex; flex-wrap: wrap; gap: 0 22px; flex: 1; }
  .home-topics a { background: transparent; color: #697169; font-size: 11px; padding: 12px 0; min-height: 40px; border-bottom: 2px solid transparent; }
  .home-topics a[aria-current="true"] { color: #426353; border-color: #426353; font-weight: 650; }
  .home-topics a:hover { color: var(--green); }
  .home-search { width: 132px; flex: none; }
  .home-search input { border: 0; border-bottom: 1px solid #c9cec5; background: transparent; padding: 10px 0; width: 100%; font-size: 11px; border-radius: 0; min-height: 40px; }
  .home-cover-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .home-results { margin: 45px 0 55px; border-top: 1px solid #344a3a; padding-top: 22px; scroll-margin-top: 22px; }
  .home-results:focus { outline: none; }
  .home-list-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 18px; margin-bottom: 14px; }
  .home-list-heading h2 { font-size: 20px; font-weight: 550; margin: 0; letter-spacing: -.5px; }
  .home-list-actions { display: flex; align-items: center; gap: 24px; font-size: 11px; }
  .home-list-actions a, .home-list-actions button { display: inline-flex; align-items: center; min-height: 40px; }
  .home-list-actions button { background: transparent; border: 0; padding: 0; color: #75806f; cursor: pointer; }
  .home-list-actions button[aria-pressed="true"] { color: var(--green); font-weight: 650; }
  .home-list-actions button span { font: 9px var(--mono); margin-left: 6px; }
  .home-list-actions a { color: #67765f; gap: 10px; }
  .home-result-meta { display: flex; justify-content: space-between; gap: 20px; align-items: center; margin-bottom: 5px; font-size: 10px; color: var(--muted); }
  .home-result-meta p { margin: 0; }
  .home-result-meta button { border: 0; padding: 10px 0; background: transparent; color: inherit; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .home-row { display: grid; grid-template-columns: 120px minmax(0, 1fr) 90px; align-items: center; gap: 24px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .home-row-topic { font: 10px var(--mono); color: #526b56; }
  .home-row h3 { font-size: 14px; font-weight: 500; line-height: 1.7; word-break: keep-all; overflow-wrap: anywhere; margin: 0; }
  .home-row h3 a:hover { color: var(--green); text-decoration: underline; text-underline-offset: 4px; }
  .home-row time { font: 10px var(--mono); color: #7b837c; text-align: right; }
  #home-empty { padding: 30px 0; font-size: 13px; color: var(--muted); line-height: 1.9; }
  @media (min-width: 1450px) { .home-cover-grid { gap: 18px; } }
  @media (max-width: 1120px) { .home-filter-bar { gap: 15px; } .home-topics { gap: 0 17px; } .home-cover-grid { gap: 10px; } }
  @media (max-width: 900px) { .home-wrap { width: calc(100% - 64px); } }
  @media (max-width: 850px) { .home-cover-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; } .home-search { width: 105px; } .home-filter-bar { align-items: flex-end; } .home-row { grid-template-columns: 100px minmax(0, 1fr) 80px; gap: 15px; } }
  @media (max-width: 600px) { .home-wrap { width: calc(100% - 40px); } }
  @media (max-width: 550px) {
    .home-filter-bar { display: block; padding: 12px 0 19px; } .home-topics { gap: 0 19px; }
    .home-topics a { font-size: 10px; min-height: 38px; padding: 10px 0; } .home-search { display: block; width: 100%; margin-top: 6px; }
    .home-search input { min-height: 33px; padding: 7px 0; font-size: 10px; } .home-cover-grid { gap: 9px; }
    .home-results { margin-top: 30px; padding-top: 20px; } .home-list-heading { flex-wrap: wrap; gap: 8px 15px; }
    .home-list-heading h2 { font-size: 18px; } .home-list-actions { font-size: 10px; gap: 15px; }
    .home-row { grid-template-columns: 1fr auto; gap: 7px 12px; padding: 18px 0; }
    .home-row-topic { grid-column: 1; grid-row: 1; font-size: 9px; } .home-row time { grid-column: 2; grid-row: 1; font-size: 9px; }
    .home-row h3 { grid-column: 1/-1; grid-row: 2; font-size: 13px; line-height: 1.85; }
  }
</style>

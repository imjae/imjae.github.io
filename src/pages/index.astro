---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeArticleLink from '../components/HomeArticleLink.astro';
import shrine from '../assets/home/dcb-shrine.png';
import { getArticles } from '../lib/articles';
import { selectPinnedArticles } from '../lib/pinned-articles.mjs';

const pinnedArticles = selectPinnedArticles(await getArticles(false));
const previewArticles = pinnedArticles.slice(0, 3);
const moreArticles = pinnedArticles.slice(3);
---
<BaseLayout title="Home" active="home">
  <section class="cinematic-hero" aria-labelledby="home-title">
    <Image class="cinematic-backdrop" src={shrine} alt="DCB 신단의 폭포와 푸른 안개" widths={[640, 1280, 1920]} sizes="(max-width: 600px) 195vw, 120vw" format="webp" quality={85} loading="eager" fetchpriority="high" />
    <div class="cinematic-shade" aria-hidden="true"></div>
    <div class="cinematic-title home-wrap">
      <p class="scene-eyebrow"><span aria-hidden="true"></span>FROM THE PROJECT</p>
      <h1 id="home-title">DCB<span>신단</span></h1>
      <a href="/projects/dcb/" class="cinematic-project">프로젝트 보기 <span aria-hidden="true">↗</span></a>
      <div class="scene-index"><span>01 / SCENE</span><span>UNITY · GAME DEVELOPMENT</span></div>
    </div>
  </section>
  {pinnedArticles.length > 0 && <section class="home-pinned home-wrap" aria-labelledby="pinned-title">
    <div class="home-pinned-heading">
      <h2 id="pinned-title">Pinned <sup>{pinnedArticles.length.toString().padStart(2, '0')}</sup></h2>
      <a href="/writing/">전체 글 보기 <span aria-hidden="true">↗</span></a>
    </div>
    <div class="home-pinned-list">{previewArticles.map((article, index) => <HomeArticleLink article={article} index={index + 1} />)}</div>
    {moreArticles.length > 0 && <details class="home-more-pins">
      <summary><span class="when-closed">고정 글 {moreArticles.length}편 더 보기</span><span class="when-open">고정 글 접기</span><span class="expand-mark" aria-hidden="true">+</span></summary>
      <div class="home-pinned-list">{moreArticles.map((article, index) => <HomeArticleLink article={article} index={index + 4} />)}</div>
    </details>}
  </section>}
</BaseLayout>
<style>
  .home-wrap { width: calc(100% - 112px); max-width: 1200px; margin-inline: auto; }
  .cinematic-hero { height: 560px; position: relative; overflow: hidden; background: #172938; color: #f2f4f4; }
  .cinematic-backdrop { position: absolute; display: block; width: 120%; height: 150%; left: -10%; top: -32%; object-fit: cover; object-position: center 54%; max-width: none; }
  .cinematic-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(9,15,22,.53), rgba(9,15,22,.02) 35%, rgba(9,15,22,.2) 55%, rgba(12,23,31,.88)); }
  .cinematic-title { position: absolute; inset: auto 0 0; padding-bottom: 27px; }
  .scene-eyebrow { display: flex; gap: 10px; align-items: center; font: 9px var(--mono); letter-spacing: 1.4px; color: #c3d8eb; margin: 0 0 18px; }
  .scene-eyebrow > span { width: 5px; height: 5px; background: #b5d7f6; border-radius: 50%; }
  .cinematic-title h1 { font-size: 68px; letter-spacing: -3px; font-weight: 500; line-height: 1; margin: 0; }
  .cinematic-title h1 span { font-size: 15px; letter-spacing: .5px; display: inline-block; margin-left: 25px; font-weight: 400; }
  .cinematic-project { position: absolute; right: 0; bottom: 79px; display: flex; align-items: center; gap: 33px; min-height: 44px; font-size: 12px; }
  .cinematic-project > span { width: 46px; height: 46px; border: 1px solid #8fa8bd75; border-radius: 50%; display: grid; place-items: center; font-size: 23px; }
  .cinematic-project:hover { color: #c2e0e8; }
  .cinematic-project:focus-visible { outline-color: #c2e0e8; }
  .scene-index { border-top: 1px solid #728ca551; padding-top: 21px; margin-top: 32px; display: flex; justify-content: space-between; font: 9px var(--mono); letter-spacing: 1px; color: #bccbd4; }
  .home-pinned { margin-top: 46px; margin-bottom: 62px; }
  .home-pinned-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 19px; }
  .home-pinned-heading h2 { font-size: 22px; letter-spacing: -.7px; font-weight: 550; color: #293b36; margin: 0; }
  .home-pinned-heading sup { font: 10px var(--mono); margin-left: 10px; color: var(--muted); vertical-align: super; }
  .home-pinned-heading > a { font-size: 11px; display: flex; align-items: center; gap: 14px; min-height: 44px; }
  .home-pinned-heading > a:hover { color: var(--green); }
  .home-pinned-list { border-top: 1px solid var(--line); }
  .home-more-pins { margin-top: 12px; }
  .home-more-pins summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 0; cursor: pointer; font-size: 11px; color: var(--muted); list-style: none; }
  .home-more-pins summary::-webkit-details-marker { display: none; }
  .home-more-pins summary:hover { color: var(--green); }
  .home-more-pins summary:focus-visible { outline: 2px solid var(--green); outline-offset: 5px; }
  .expand-mark { font-size: 20px; line-height: 1; }
  .when-open, .home-more-pins[open] .when-closed { display: none; }
  .home-more-pins[open] .when-open { display: inline; }
  .home-more-pins[open] .expand-mark { transform: rotate(45deg); }
  @media (min-width: 1600px) { .cinematic-hero { height: 610px; } }
  @media (max-width: 900px) { .home-wrap { width: calc(100% - 64px); } }
  @media (max-width: 600px) {
    .home-wrap { width: calc(100% - 40px); }
    .cinematic-hero { height: 505px; }
    .cinematic-backdrop { width: 195%; left: -47.5%; height: 118%; top: -15%; object-position: 50% 56%; }
    .cinematic-title { padding-bottom: 22px; }
    .cinematic-title h1 { font-size: 54px; letter-spacing: -2px; }
    .cinematic-title h1 span { font-size: 13px; margin-left: 15px; }
    .scene-eyebrow { margin-bottom: 15px; font-size: 7px; letter-spacing: 1px; }
    .cinematic-project { bottom: 71px; gap: 11px; font-size: 9px; }
    .cinematic-project > span { width: 30px; height: 30px; font-size: 18px; }
    .scene-index { margin-top: 29px; padding-top: 20px; font-size: 7px; letter-spacing: .3px; }
    .home-pinned { margin-top: 31px; margin-bottom: 41px; }
    .home-pinned-heading { margin-bottom: 12px; }
    .home-pinned-heading h2 { font-size: 21px; }
    .home-pinned-heading > a { font-size: 10px; }
  }
  @media (max-width: 360px) {
    .cinematic-title h1 { font-size: 49px; }
    .cinematic-title h1 span { font-size: 12px; margin-left: 12px; }
    .cinematic-project { font-size: 8px; gap: 8px; }
    .scene-index { font-size: 6px; }
  }
</style>

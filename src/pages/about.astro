---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { about } from '../data/about';
import { site } from '../data/site';

const { profile, portrait } = about;
const field = (value: string, hint: string) => value.trim() || `[${hint}]`;
const githubLabel = site.github.replace(/^https?:\/\//, '').replace(/\/$/, '');
---
<BaseLayout title="About" active="about" description="imjae의 짧은 소개와 하는 일, 관심 분야, 연락처입니다.">
  <div class="about-profile">
    <div class="profile-copy">
      <header class="profile-intro">
        <p class="eyebrow">ABOUT</p>
        <h1>{field(profile.name, '이름')}</h1>
        <p class="profile-summary">{field(profile.summary, '짧은 소개')}</p>
      </header>
      <dl class="profile-facts">
        <div class="profile-fact">
          <dt>하는 일</dt>
          <dd>{field(profile.role, '하는 일')}</dd>
        </div>
        <div class="profile-fact">
          <dt>관심 분야</dt>
          <dd>{field(profile.interests, '관심 분야')}</dd>
        </div>
        <div class="profile-fact">
          <dt>연락</dt>
          <dd class="profile-links">
            {profile.email.trim()
              ? <a href={`mailto:${profile.email.trim()}`}>{profile.email}</a>
              : <span class="empty-link">[이메일 입력]</span>}
            <a href={site.github} target="_blank" rel="noopener noreferrer">{githubLabel} <span aria-hidden="true">↗</span><span class="sr-only"> (새 탭)</span></a>
          </dd>
        </div>
      </dl>
    </div>
    <figure class="profile-photo">
      <Image src={portrait.image} alt={portrait.alt} format="webp" widths={[360, 680, 865]} sizes="(max-width: 380px) calc(100vw - 44px), 340px" loading="eager" fetchpriority="high" />
    </figure>
  </div>
</BaseLayout>

<style>
  :global(body.about-page) { --paper: #fff; background: var(--paper); min-height: 100vh; }
  .about-profile { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .9fr); gap: 64px; align-items: start; max-width: 960px; margin: 0 auto; padding: 0 0 36px; font-size: 14px; line-height: 1.8; overflow-wrap: anywhere; }
  .profile-copy { min-width: 0; }
  .profile-intro .eyebrow { margin: 0 0 12px; font-size: 10px; letter-spacing: 1.7px; }
  h1 { margin: 0; font: 400 64px/1.1 Georgia, 'Times New Roman', serif; letter-spacing: -2px; }
  .profile-summary { margin: 22px 0 0; font-size: 15px; line-height: 1.95; white-space: pre-line; word-break: keep-all; }
  .profile-facts { margin: 36px 0 0; }
  .profile-fact { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 16px; padding: 18px 0; border-top: 1px solid var(--line); }
  .profile-fact dt { font-size: 11px; color: var(--muted); line-height: 1.9; }
  .profile-fact dd { margin: 0; font-size: 13px; word-break: keep-all; }
  .profile-links { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 20px; }
  .profile-links a { text-decoration: underline; text-underline-offset: 5px; }
  .profile-links a:hover { color: var(--green); }
  .empty-link { color: var(--muted); font-size: 12px; }
  .profile-photo { width: 100%; max-width: 340px; margin: 0 0 0 auto; }
  .profile-photo img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 100%; border-radius: 2px; }
  @media (max-width: 900px) {
    .about-profile { gap: 36px; }
    .profile-fact { grid-template-columns: 65px minmax(0, 1fr); gap: 12px; }
  }
  @media (max-width: 650px) {
    .about-profile { grid-template-columns: 1fr; gap: 30px; padding-bottom: 0; }
    h1 { font-size: 52px; }
    .profile-summary { font-size: 14px; margin-top: 18px; }
    .profile-facts { margin-top: 26px; }
    .profile-fact { padding: 16px 0; }
    .profile-links a { display: inline-flex; align-items: center; gap: 5px; min-height: 44px; }
    .profile-photo { margin: 0 auto; }
  }
  @media print { .about-profile { break-inside: avoid; } }
</style>

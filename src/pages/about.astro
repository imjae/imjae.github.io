---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { about } from '../data/about';
import { site } from '../data/site';

const { profile, projects } = about;
const field = (value: string, hint: string) => value.trim() || `[${hint}]`;
const projectCount = String(projects.length).padStart(2, '0');
---
<BaseLayout title="About" active="about" description="imjae의 소개와 프로젝트를 모았습니다.">
  <div class="about-profile">
    <header class="profile-intro">
      <div>
        <p class="eyebrow">ABOUT</p>
        <h1>{field(profile.name, '이름')}</h1>
        <p class="profile-role">{field(profile.role, '하는 일 · 관심 분야')}</p>
        <p class="profile-summary">{field(profile.summary, '짧은 소개')}</p>
      </div>
      <div class="profile-links">
        {profile.email.trim()
          ? <a href={`mailto:${profile.email.trim()}`}>{profile.email}</a>
          : <span class="empty-link">이메일 [주소]</span>}
        <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (새 탭)</span></a>
      </div>
    </header>

    {projects.length > 0 && <section class="project-album" aria-labelledby="projects-heading" data-project-album>
      <div class="album-heading">
        <h2 id="projects-heading">프로젝트</h2>
        <span class="album-count" data-album-count aria-hidden="true">{projectCount}</span>
      </div>
      <div class="album-panels">
        {projects.map((project, index) => <article class="album-panel" id={`about-project-${project.id}`} data-album-panel aria-labelledby={`about-project-${project.id}-heading`}>
          <div class="album-cover">
            {project.cover
              ? <Image src={project.cover.image} alt={project.cover.alt} format="webp" widths={[480, 960, 1440]} sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 1150px) calc(100vw - 64px), 1040px" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />
              : <div class="album-wordmark" aria-hidden="true">{field(project.name, '프로젝트 이름')}<span>.</span></div>}
          </div>
          <div class="album-caption">
            <div>
              <h3 id={`about-project-${project.id}-heading`}>{field(project.name, '프로젝트 이름')}</h3>
              {project.summary.trim() && <p>{project.summary}</p>}
            </div>
            {project.url.trim() && <a class="project-link" href={project.url}>{field(project.linkLabel, '프로젝트 보기')} <span aria-hidden="true">↗</span><span class="sr-only"> — {project.name}</span></a>}
          </div>
        </article>)}
      </div>
      {projects.length > 1 && <div class="album-picker" role="group" aria-label="프로젝트 선택" data-album-picker hidden>
        {projects.map((project, index) => <button type="button" class="album-choice" data-album-choice aria-controls={`about-project-${project.id}`} aria-pressed={index === 0 ? 'true' : 'false'}>
          {project.cover
            ? <Image class="album-thumbnail" src={project.cover.image} alt="" format="webp" width={112} height={80} loading="lazy" />
            : <span class="album-thumbnail album-thumbnail-wordmark" aria-hidden="true">{project.name.slice(0, 2)}.</span>}
          <span>{field(project.name, '프로젝트 이름')}</span>
        </button>)}
      </div>}
      <p class="sr-only" data-album-status role="status" aria-atomic="true"></p>
    </section>}
  </div>
</BaseLayout>

<script>
  import '../scripts/about-projects';
</script>

<style>
  .about-profile { max-width: 1040px; margin: 0 auto; font-size: 14px; line-height: 1.8; overflow-wrap: anywhere; }
  .profile-intro { display: flex; justify-content: space-between; align-items: flex-end; gap: 25px 48px; padding: 4px 0 40px; }
  .profile-intro > div:first-child { min-width: 0; }
  .profile-intro .eyebrow { margin-bottom: 16px; font-size: 10px; }
  h1 { font-size: clamp(32px, 3.5vw, 42px); line-height: 1.25; letter-spacing: -1.4px; font-weight: 650; margin-bottom: 12px; }
  .profile-role { font-size: 16px; letter-spacing: -.3px; margin-bottom: 9px; }
  .profile-summary { color: var(--muted); max-width: 680px; white-space: pre-line; }
  .profile-links { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; flex-shrink: 0; max-width: 40%; padding-bottom: 2px; font-size: 12px; }
  .profile-links a { display: inline-flex; align-items: center; gap: 8px; min-height: 36px; }
  .profile-links a, .project-link { text-decoration: underline; text-underline-offset: 5px; text-decoration-color: var(--line); }
  .profile-links a:hover, .project-link:hover { color: var(--green); text-decoration-color: currentColor; }
  .empty-link { color: var(--muted); }
  .album-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; border-top: 1px solid var(--line); padding-top: 18px; margin-bottom: 20px; }
  .album-heading h2 { font-size: 15px; font-weight: 500; line-height: 1.5; }
  .album-count { font: 11px var(--mono); color: var(--muted); }
  .album-panels { display: grid; gap: 40px; }
  .album-panel { min-width: 0; }
  .album-panel[hidden], .album-picker[hidden] { display: none; }
  .album-cover { display: grid; place-items: center; position: relative; aspect-ratio: 2.28; background: #e8e9e1; border-radius: 2px; overflow: hidden; }
  .album-cover img { display: block; position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .album-wordmark { color: #414b40; font: 500 clamp(40px, 6vw, 76px)/1.2 var(--mono); letter-spacing: -4px; padding: 24px; text-align: center; max-width: 100%; }
  .album-wordmark span { color: #718269; }
  .album-caption { display: flex; justify-content: space-between; align-items: flex-start; gap: 14px 25px; padding-top: 17px; }
  .album-caption > div { min-width: 0; }
  .album-caption h3 { font-size: 19px; font-weight: 600; line-height: 1.5; letter-spacing: -.35px; }
  .album-caption p { color: var(--muted); font-size: 13px; margin-top: 5px; }
  .project-link { flex-shrink: 0; padding: 5px 0; font-size: 12px; }
  .album-picker { display: flex; flex-wrap: wrap; gap: 12px 24px; border-top: 1px solid var(--line); padding-top: 20px; margin-top: 25px; }
  .album-choice { display: flex; align-items: center; gap: 11px; max-width: 100%; min-height: 52px; padding: 6px 0; background: transparent; border: 0; border-bottom: 1px solid transparent; border-radius: 0; color: var(--muted); font: 12px/1.5 var(--sans); cursor: pointer; text-align: left; }
  .album-choice[aria-pressed='true'] { color: var(--ink); border-bottom-color: var(--green); }
  .album-choice:hover { color: var(--green); }
  .album-thumbnail { display: block; width: 56px; height: 40px; object-fit: cover; border-radius: 1px; flex-shrink: 0; }
  .album-thumbnail-wordmark { display: grid; place-items: center; background: #e8e9e1; color: #414b40; font: 12px var(--mono); }
  @media (max-width: 760px) {
    .profile-intro { display: block; padding-bottom: 30px; }
    .profile-links { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 4px 22px; max-width: none; margin-top: 17px; padding: 0; }
    .profile-links a { min-height: 44px; }
    .album-cover { aspect-ratio: 1.2; }
    .album-wordmark { font-size: clamp(32px, 10vw, 56px); letter-spacing: -2px; padding: 20px; }
    .album-caption { display: block; }
    .album-caption h3 { font-size: 18px; }
    .project-link { display: inline-flex; align-items: center; gap: 6px; margin-top: 7px; min-height: 44px; }
    .album-picker { padding-top: 15px; margin-top: 18px; gap: 8px 23px; }
  }
  @media print {
    .profile-intro { padding-bottom: 22px; }
    .album-panel[hidden] { display: block; }
    .album-panel { break-inside: avoid; }
    .album-picker, .album-count { display: none; }
  }
</style>

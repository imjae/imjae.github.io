---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { about } from '../data/about';
import { site } from '../data/site';
import { privateAuthoring } from '../lib/authoring.server.mjs';
import { readAboutCopy } from '../lib/about-copy.server.mjs';
import AboutEditor from '../components/AboutEditor.astro';

const { portrait } = about;
const profile = await readAboutCopy({ ...about.profile, github: site.github });
const field = (value: string, hint: string) => value.trim() || `[${hint}]`;
const githubLabel = profile.github.replace(/^https?:\/\//, '').replace(/\/$/, '');
---
<BaseLayout title="About" active="about" inlineEditor description="imjae의 짧은 소개와 하는 일, 관심 분야, 연락처입니다.">
  <div class="about-profile">
    <figure class="profile-photo">
      <Image src={portrait.image} alt={portrait.alt} format="webp" widths={[360, 680, 865]} sizes="(max-width: 650px) calc(100vw - 44px), (max-width: 1120px) 46vw, 480px" loading="eager" fetchpriority="high" />
    </figure>
    <div class="profile-copy">
      <div id="about-profile-view">
      <header class="profile-intro">
        <p class="eyebrow">ABOUT</p>
        <h1 data-about-value="name">{field(profile.name, '이름')}</h1>
        <p class="profile-summary" data-about-value="summary">{field(profile.summary, '짧은 소개')}</p>
      </header>
      <dl class="profile-facts">
        <div class="profile-fact">
          <dt>하는 일</dt>
          <dd data-about-value="role">{field(profile.role, '하는 일')}</dd>
        </div>
        <div class="profile-fact">
          <dt>관심 분야</dt>
          <dd data-about-value="interests">{field(profile.interests, '관심 분야')}</dd>
        </div>
      </dl>
      <nav class="profile-links" aria-label="연락">
            <span data-about-email>{profile.email.trim()
              ? <a href={`mailto:${profile.email.trim()}`}>{profile.email}</a>
              : <span class="empty-link">[이메일 입력]</span>}</span>
            <a data-about-github href={profile.github} target="_blank" rel="noopener noreferrer">{githubLabel} <span aria-hidden="true">↗</span><span class="sr-only"> (새 탭)</span></a>
      </nav>
      </div>
      {privateAuthoring && <AboutEditor fields={profile} />}
    </div>
  </div>
</BaseLayout>

<style>
  :global(body.about-page) { --paper: #f6f3ec; --line: #d8d1c2; --soft: #efeade; background: var(--paper); min-height: 100vh; }
  :global(body.about-page .workspace-about) { padding-top: 42px; padding-bottom: 48px; }
  .about-profile { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 48px; align-items: center; max-width: 960px; margin: 0 auto; font-size: 14px; line-height: 1.8; overflow-wrap: anywhere; }
  .profile-copy { min-width: 0; }
  .profile-intro .eyebrow { margin: 0 0 12px; font-size: 10px; letter-spacing: 1.7px; }
  h1 { margin: 0; font: 400 62px/1.1 Georgia, 'Times New Roman', serif; letter-spacing: -2px; }
  .profile-summary { margin: 22px 0 0; font-size: 15px; line-height: 1.95; white-space: pre-line; word-break: keep-all; }
  .profile-facts { margin: 36px 0 0; }
  .profile-fact { padding: 15px 0; border-top: 1px solid var(--line); }
  .profile-fact dt { margin-bottom: 6px; font-size: 11px; color: var(--muted); line-height: 1.9; }
  .profile-fact dd { margin: 0; font-size: 13px; word-break: keep-all; }
  .profile-links { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 22px; margin-top: 24px; font-size: 12px; }
  .profile-links :global(a) { text-decoration: underline; text-underline-offset: 5px; }
  .profile-links :global(a:hover) { color: var(--green); }
  .profile-links :global(.empty-link) { color: var(--muted); font-size: 12px; }
  .profile-photo { width: 100%; margin: 0; align-self: start; }
  .profile-photo img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 100%; }
  @media (max-width: 900px) {
    .about-profile { gap: 32px; }
  }
  @media (max-width: 650px) {
    :global(body.about-page .workspace-about) { padding-top: 24px; }
    .about-profile { grid-template-columns: 1fr; gap: 30px; max-width: 480px; }
    h1 { font-size: 52px; }
    .profile-summary { font-size: 14px; margin-top: 18px; }
    .profile-facts { margin-top: 26px; }
    .profile-fact { display: grid; grid-template-columns: 65px minmax(0, 1fr); gap: 12px; padding: 16px 0; }
    .profile-fact dt { margin: 0; }
    .profile-links :global(a) { display: inline-flex; align-items: center; gap: 5px; min-height: 44px; }
    :global(body.about-page:has(#about-edit-form:not([hidden]))) .profile-copy { order: -1; }
  }
  @media print { .about-profile { break-inside: avoid; } }
</style>

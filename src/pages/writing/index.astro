---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleLibrary from '../../components/ArticleLibrary.astro';
import { privateAuthoring } from '../../lib/authoring.server.mjs';
---
<BaseLayout title="글 모아보기" active="writing">
  <header class="page-intro"><h1>글 모아보기</h1><p>게임 개발과 관련 기술에 관한 글입니다. 제목, 본문, 태그로 검색할 수 있습니다.</p></header>
  {privateAuthoring && <div class="writing-actions"><a class="button button-dark" href="/editor/#new-post">새 글 작성</a></div>}
  <ArticleLibrary />
</BaseLayout>

<style>
  .writing-actions { margin-bottom: 20px; }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { games } from '../../data/games.mjs';
---
<BaseLayout title="Games" description="기획하고 개발 중인 게임들." active="games">
  <header class="games-heading"><h1>Games</h1><p>기획하고 개발 중인 게임들.</p></header>
  <div class="game-albums">
    {games.map(game => <a class="game-album" href={`/games/${game.id}/`}>
      <img src={game.cover} alt={game.alt} width="960" height="720" decoding="async" />
      <h2>{game.title}</h2>
    </a>)}
  </div>
</BaseLayout>
<style>
  .games-heading { margin-bottom: 42px; }
  h1 { margin: 0; font-size: 32px; font-weight: 650; letter-spacing: -.035em; }
  .games-heading p { margin: 10px 0 0; color: var(--muted); font-size: 14px; }
  .game-albums { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 30px; padding-bottom: 100px; }
  .game-album { display: block; min-width: 0; color: inherit; text-decoration: none; }
  .game-album img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 3px; background: #e8e9e2; }
  .game-album h2 { margin: 17px 0 0; font-size: 18px; font-weight: 600; letter-spacing: -.025em; }
  .game-album:hover h2 { text-decoration: underline; text-underline-offset: 5px; }
  .game-album:focus-visible { outline: 2px solid var(--green); outline-offset: 7px; border-radius: 3px; }
  @media (max-width: 760px) { .game-albums { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 22px; } }
  @media (max-width: 520px) { .games-heading { margin-bottom: 28px; } h1 { font-size: 29px; } .game-albums { grid-template-columns: 1fr; gap: 34px; padding-bottom: 50px; } }
</style>

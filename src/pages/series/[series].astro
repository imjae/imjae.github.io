---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import StudyCourse from '../../components/StudyCourse.astro';
import { studyCourses } from '../../data/study-courses.mjs';
import { getArticles } from '../../lib/articles';
import { seriesTitle } from '../../data/site';
export async function getStaticPaths() {
  return [...new Set(['dcb', ...studyCourses.map(course => course.id), ...(await getArticles()).map((article) => article.data.series).filter(Boolean)])].map((series) => ({ params: { series }, props: { series: series! } }));
}
const { series } = Astro.props;
const course = studyCourses.find(course => course.id === series);
const articles = (await getArticles()).filter((article) => article.data.series === series).sort((a,b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---
<BaseLayout title={seriesTitle(series)} description={course?.description} active={course ? 'study' : series === 'dcb' ? 'dcb' : 'writing'}>{course ? <StudyCourse course={course} /> : <><header class="page-intro"><p class="eyebrow">시리즈</p><h1>{seriesTitle(series)}</h1><p>{series === 'dcb' ? 'DCB의 기능별 구현 기록입니다.' : '같은 주제로 작성한 글 목록입니다.'}</p></header><div class="article-list">{articles.map((article,index) => <ArticleCard article={article} number={String(index+1).padStart(2,'0')} />)}</div></>}</BaseLayout>

---
import ArticleCard from '../../../components/ArticleCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getArticles } from '../../../lib/articles';

const description = 'C++과 HLSL로 만드는 Windows용 Direct3D 12 렌더러입니다. 프레임 동기화와 인스턴싱을 구현하고 같은 장면에서 성능을 비교합니다.';
const articles = (await getArticles(false))
  .filter((article) => article.data.project === 'd3d12-renderer')
  .sort((a, b) => a.data.date.localeCompare(b.data.date));
---
<BaseLayout title="D3D12 Renderer" description={description} active="portfolio">
  <header class="page-intro">
    <a class="back-link" href="/portfolio/">← 포트폴리오</a>
    <h1>D3D12 Renderer</h1>
    <p>{description}</p>
    <p>AI 바이브 코딩 없이 렌더러의 설계, 구현, 디버깅을 직접 합니다.</p>
    <a class="source-link" href="https://github.com/imjae/d3d12-renderer">GitHub 저장소 <span aria-hidden="true">↗</span></a>
  </header>
  <section aria-labelledby="renderer-posts">
    <div class="section-heading"><h2 id="renderer-posts">개발 기록</h2></div>
    <div class="article-list">{articles.map((article) => <ArticleCard article={article} />)}</div>
  </section>
</BaseLayout>
<style>
  .back-link, .source-link { display: inline-block; color: var(--green); }
  .back-link { margin-bottom: 16px; font-size: 14px; }
  .source-link { margin-top: 12px; font-size: 15px; }
  .back-link:hover, .source-link:hover { text-decoration: underline; text-underline-offset: 4px; }
</style>

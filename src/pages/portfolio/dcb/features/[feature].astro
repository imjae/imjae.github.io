---
import DcbRedirect from '../../../../components/DcbRedirect.astro';
import { dcbFeatures } from '../../../../data/dcb-features.mjs';
import { featureUrl } from '../../../../lib/portfolio-features.mjs';
export function getStaticPaths() {
  return dcbFeatures.map(feature => ({ params: { feature: feature.slug }, props: { target: featureUrl(feature) } }));
}
---
<DcbRedirect target={Astro.props.target} />

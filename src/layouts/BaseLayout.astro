---
import '../styles/global.css';
import { site, topics } from '../data/site';
import { getArticles } from '../lib/articles';
import { getReadingItems } from '../lib/reading-shelf.server';
import { githubFileUrl } from '../lib/github-authoring.mjs';
import ModeSwitch from '../components/ModeSwitch.astro';
interface Props { title?: string; description?: string; active?: string; noindex?: boolean; editFile?: string; editProject?: string; }
const { title, description = site.description, active = '', noindex = false, editFile, editProject } = Astro.props;
const articles = await getArticles();
const readingCount = (await getReadingItems(articles)).length;
const canonical = new URL(Astro.url.pathname, site.url);
const editorUrl = editFile ? githubFileUrl('edit', editFile) : editProject === 'dcb' ? '/editor/?project=dcb#project-video' : '/editor/';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — ${site.title}` : site.title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f2" />
    <meta name="author" content="imjae" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/social-card.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 이동</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="imjae home">imjae<span>.</span><small>DEV NOTES</small></a>
      <nav class="header-nav" aria-label="Main navigation">
        <a href="/" aria-current={active === 'home' ? 'page' : undefined}>Home</a>
        <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>About</a>
        <a href="/portfolio/" aria-current={active === 'portfolio' ? 'page' : undefined}>Portfolio</a>
        <a href="/writing/" aria-current={active === 'writing' ? 'page' : undefined}>Writing</a>
        <a class="github-link" href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
      <ModeSwitch editing={active === 'editor'} viewerUrl={active === 'editor' ? '/writing/' : '#main-content'} editorUrl={editorUrl} editorExternal={!!editFile} />
    </header>
    <div class="workspace">
      <aside class="sidebar" aria-label="Browse notes">
        <a class:list={['sidebar-home', { selected: active === 'home' }]} href="/"><span aria-hidden="true">⌂</span> Home</a>
        <p class="nav-caption">Topics</p>
        <nav class="topic-nav" aria-label="Topics">
          {topics.map((topic) => <a href={`/topics/${topic.id}/`} class:list={{ selected: active === topic.id }} style={`--topic-color:${topic.color}`}><span class="topic-mark"></span>{topic.title}<small>{(topic.id === 'reading' ? readingCount : articles.filter((article) => article.data.topic === topic.id).length).toString().padStart(2, '0')}</small></a>)}
        </nav>
        <div class="sidebar-project"><p class="nav-caption">Projects</p><a href="/portfolio/dcb/"><span class="project-icon">D</span><span><strong>DCB</strong><small>Action game · In development</small></span><span aria-hidden="true">↗</span></a><a class="sidebar-series" href="/series/dcb/">DCB articles <span aria-hidden="true">→</span></a></div>
        <div class="sidebar-foot"><a href="/rss.xml">RSS feed ↗</a></div>
      </aside>
      <main id="main-content"><slot /></main>
    </div>
    <footer class="site-footer"><span>© {new Date().getUTCFullYear()} imjae</span><span>게임 개발 블로그</span><a href="https://github.com/imjae/imjae.github.io" target="_blank" rel="noopener noreferrer">Source ↗</a></footer>
  </body>
</html>

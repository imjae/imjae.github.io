---
import '../styles/global.css';
import '../styles/reading-theme.css';
import { site, topics } from '../data/site';
import { getArticles } from '../lib/articles';
import { getReadingItems } from '../lib/reading-shelf.server';
import { githubFileUrl } from '../lib/github-authoring.mjs';
import ModeSwitch from '../components/ModeSwitch.astro';
import PublishProgress from '../components/PublishProgress.astro';
import { privateAuthoring } from '../lib/authoring.server.mjs';
interface Props { title?: string; description?: string; active?: string; noindex?: boolean; editFile?: string; editProject?: string; reading?: boolean; inlineEditor?: boolean; }
const { title, description = site.description, active = '', noindex = false, editFile, editProject, reading = false, inlineEditor = false } = Astro.props;
const articles = await getArticles();
const readingCount = (await getReadingItems(articles)).length;
const canonical = new URL(Astro.url.pathname, site.url);
const editorUrl = editFile ? githubFileUrl('edit', editFile) : editProject === 'dcb' ? '/editor/?project=dcb#project-video' : '/editor/';
const writingSection = ['writing', 'topics', 'series'].includes(Astro.url.pathname.split('/')[1]);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — ${site.title}` : site.title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf7" />
    <meta name="author" content="imjae" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/social-card.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </head>
  <body class:list={{ 'home-page': active === 'home', 'reading-page': reading, 'about-page': active === 'about' }}>
    <a class="skip-link" href="#main-content">본문으로 이동</a>
    <header class:list={['site-header', { 'site-header-home': active === 'home' }]}>
      <a class="brand" href="/" aria-label="imjae home" aria-current={active === 'home' ? 'page' : undefined}>imjae<span>.</span><small>DEV NOTES</small></a>
      <nav class="header-nav" aria-label="Main navigation">
        <a href="/writing/" aria-current={writingSection ? Astro.url.pathname === '/writing/' ? 'page' : 'location' : undefined}>Writing</a>
        <a href="/portfolio/" aria-current={active === 'portfolio' ? 'page' : undefined}>Portfolio</a>
        <a href="/games/" aria-current={active === 'games' ? Astro.url.pathname === '/games/' ? 'page' : 'location' : undefined}>Games</a>
        <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>About</a>
      </nav>
      <div class="header-utilities">
        <a class="header-github" href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (새 탭)</span></a>
        <ModeSwitch editing={active === 'editor'} viewerUrl={active === 'editor' ? '/writing/' : '#main-content'} editorUrl={editorUrl} editorExternal={!!editFile} inlineEditor={inlineEditor} />
      </div>
    </header>
    <div class:list={['workspace', { 'workspace-home': active === 'home', 'workspace-reading': reading, 'workspace-about': active === 'about' || active === 'games' }]}>
      {active !== 'home' && active !== 'about' && active !== 'games' && !reading && <aside class="sidebar" aria-label="Browse notes">
        <a class:list={['sidebar-home', { selected: active === 'home' }]} href="/"><span aria-hidden="true">⌂</span> Home</a>
        <p class="nav-caption">Topics</p>
        <nav class="topic-nav" aria-label="Topics">
          {topics.map((topic) => <a href={`/topics/${topic.id}/`} class:list={{ selected: active === topic.id }} style={`--topic-color:${topic.color}`}><span class="topic-mark"></span>{topic.title}<small>{(topic.id === 'reading' ? readingCount : articles.filter((article) => article.data.topic === topic.id).length).toString().padStart(2, '0')}</small></a>)}
        </nav>
        <div class="sidebar-project"><p class="nav-caption">Projects</p><a href="/projects/dcb/" class:list={{ selected: active === 'dcb' }} aria-current={Astro.url.pathname === '/projects/dcb/' ? 'page' : undefined}><span class="project-icon">D</span><span><strong>DCB</strong><small>Action game · In development</small></span><span aria-hidden="true">↗</span></a><a class="sidebar-series" href="/series/dcb/" aria-current={Astro.url.pathname === '/series/dcb/' ? 'page' : undefined}>DCB articles <span aria-hidden="true">→</span></a></div>
        <div class="sidebar-foot"><a href="/rss.xml">RSS feed ↗</a></div>
      </aside>}
      <main id="main-content"><slot /></main>
    </div>
    <footer class="site-footer"><span>© {new Date().getUTCFullYear()} imjae</span><span>게임 개발 블로그</span><a href="https://github.com/imjae/imjae.github.io" target="_blank" rel="noopener noreferrer">Source ↗</a></footer>
    {privateAuthoring && <PublishProgress />}
  </body>
</html>
<style>
  .site-header { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 32px; }
  .site-header-home { width: calc(100% - 112px); max-width: 1200px; height: 112px; padding: 0; }
  .site-header-home .brand small { display: none; }
  .brand { justify-self: start; white-space: nowrap; }
  .header-nav { gap: 28px; }
  .header-nav a { display: inline-flex; align-items: center; min-height: 44px; }
  .header-utilities { display: flex; align-items: center; justify-self: end; gap: 22px; }
  .header-github { display: inline-flex; align-items: center; gap: 7px; min-height: 44px; font: 11px var(--mono); color: var(--muted); white-space: nowrap; }
  .header-github:hover { color: var(--green); text-decoration: underline; text-underline-offset: 5px; }
  .workspace-home { display: block; max-width: none; padding: 0; }
  .workspace-reading { display: block; max-width: 1184px; padding-top: 44px; }
  .workspace-about { display: block; max-width: 1184px; padding-top: 58px; }
  .home-page .site-footer { width: calc(100% - 112px); max-width: 1200px; padding: 26px 0 34px; }
  @media (max-width: 1150px) {
    .site-header { gap: 22px; }
    .header-nav { gap: 22px; }
    .header-utilities { gap: 16px; }
  }
  @media (max-width: 900px) {
    .site-header-home, .home-page .site-footer { width: calc(100% - 64px); }
  }
  @media (max-width: 760px) {
    .site-header { grid-template-columns: minmax(0, 1fr) auto; gap: 10px 20px; padding-bottom: 12px; }
    .brand { grid-column: 1; grid-row: 1; }
    .header-nav { grid-column: 1; grid-row: 2; order: 0; width: auto; justify-content: flex-start; gap: 16px; font-size: 12px; }
    .header-utilities { display: contents; }
    .header-utilities :global(.mode-switch) { grid-column: 2; grid-row: 1; justify-self: end; }
    .header-github { grid-column: 2; grid-row: 2; justify-self: end; font-size: 10px; }
    .site-header-home { height: 115px; padding: 15px 0 12px; gap: 0 20px; }
    .workspace-reading { padding-top: 29px; }
    .workspace-about { padding-top: 36px; }
  }
  @media (max-width: 600px) {
    .site-header-home, .home-page .site-footer { width: calc(100% - 40px); }
  }
  @media print { .site-header { display: none; } }
  @media (max-width: 420px) { .site-header { column-gap: 12px; } .header-nav { gap: 12px; } }
</style>

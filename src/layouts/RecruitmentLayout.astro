---
import '../styles/recruitment.css';
import { site } from '../data/site';
import { privateAuthoring, authorLoginUrl } from '../lib/authoring.server.mjs';
import AuthorSessionGuard from '../components/AuthorSessionGuard.astro';
import PublishProgress from '../components/PublishProgress.astro';

interface Props { title: string; description: string; sourceHash?: string; }
const { title, description, sourceHash } = Astro.props;
const canonical = new URL('/portfolio/2027/', site.url);
const sections = [
  ['project', 'Project'], ['ai', 'AI Usage'], ['client', 'Implementation'],
  ['graphics', 'Graphics'],
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="imjae" />
    <meta name="theme-color" content="#f7f7f2" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/social-card.png`} />
  </head>
  <body class="recruitment-page">
    <a class="rp-skip" href="#main-content">본문으로 이동</a>
    <header class="rp-header">
      <div class="rp-header-inner">
        <a class="rp-brand" href="#main-content" aria-label="Portfolio home">imjae<span>.</span><small>PORTFOLIO / 2027</small></a>
        <nav class="rp-nav" aria-label="Portfolio navigation">
          {sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
        </nav>
        <div class="rp-header-actions">
          <a class="rp-blog-link" href="/">Blog <span aria-hidden="true">↗</span></a>
          <nav class="rp-mode-switch" aria-label="Portfolio mode">
            {privateAuthoring ? <>
              <button type="button" data-portfolio-view aria-pressed="true" disabled>View</button>
              <button type="button" data-portfolio-edit aria-pressed="false" disabled>Edit</button>
              <form action="/auth/logout" method="post"><button type="submit">Sign out</button></form>
            </> : <><a href="#main-content" aria-current="page">View</a><a href={authorLoginUrl('/portfolio/2027/?edit=1')} data-author-login>Sign in</a></>}
          </nav>
        </div>
      </div>
    </header>
    <main id="main-content" class="rp-main" tabindex="-1" data-sketch-source={sourceHash}><slot /></main>
    <footer class="rp-footer">
      <span>imjae · Game programming</span>
      <a href="/">개발 블로그</a>
      {privateAuthoring && <a href="/editor/#portfolio-copy">문구·영상 수정</a>}
      <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="rp-sr-only"> (새 탭)</span></a>
      <a href="#main-content">맨 위로 ↑</a>
    </footer>
  </body>
  {privateAuthoring && <AuthorSessionGuard />}
  {privateAuthoring && <PublishProgress />}
</html>
<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-author-login]').forEach(link => link.addEventListener('click', () => {
    const url = new URL(link.href);
    if (url.pathname === '/auth/login') { url.searchParams.set('return_to', location.pathname + '?edit=1' + location.hash); link.href = url.href; }
  }));
</script>

{
  "name": "imjae-game-dev-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "check:site": "node scripts/check-site.mjs",
    "verify": "npm run test && npm run check && npm run build && npm run check:site",
    "new": "node scripts/new-post.mjs",
    "author:build": "node scripts/build-authoring.mjs",
    "author:deploy": "npm run author:build && wrangler deploy --config wrangler.authoring.jsonc"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "astro": "7.4.0",
    "katex": "0.19.0",
    "mermaid": "12.2.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
